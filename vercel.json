{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/trivia-leads.js": {
      "runtime": "@vercel/node@3"
    },
    "api/trivia-leads/leaderboard.js": {
      "runtime": "@vercel/node@3"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}