{
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "client/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://www.organicsoilwholesale.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://www.organicsoilwholesale.com/uploads/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
