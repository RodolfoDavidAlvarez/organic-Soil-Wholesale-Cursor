# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
CHECKOUT_ALERT_TO=developer@bettersystems.ai
CHECKOUT_ALERT_FROM=OSW Alerts <info@soilseedandwater.com>
DEVELOPER_ALERT_TO=developer@bettersystems.ai

# Email
RESEND_API_KEY=re_your_resend_api_key

# Client URL (for email links)
CLIENT_URL=http://localhost:3000

# Session Secret
SESSION_SECRET=your-session-secret-here

# Phoenix Fall Garden Giveaway (/win). Entries are OPEN unless this is false.
# Production does not need this set. Use GIVEAWAY_ENTRIES_OPEN=false to pause.
# GIVEAWAY_ENTRIES_OPEN=true

# Private staff Lead Report. Sends one report for every 30 valid giveaway entries.
# Sender: Lead Report <reports@bettersystems.ai>
# GIVEAWAY_LEAD_REPORTS_ACTIVE=true
